# Adicione mais chaves de projetos diferentes para aumentar quota
# Cada chave = +10.000 units/dia
# Crie projetos em: console.cloud.google.com
YOUTUBE_API_KEY=sua_chave_projeto_1
YOUTUBE_API_KEYS=chave_projeto_2,chave_projeto_3
# Alternativa aceita:
# YOUTUBE_API_KEY_2=chave_projeto_2
# YOUTUBE_API_KEY_3=chave_projeto_3
APP_ENV=development
TOP_TOPICS_TO_PROCESS=20
REPORT_TOP_N=20
VIDEOS_PER_TOPIC=5
HIGH_ATTENTION_QUERIES_PER_MARKET=6
ENABLE_HIGH_ATTENTION_SCANNER=true
ENABLE_DYNAMIC_QUERY_EXPANSION=true
DYNAMIC_QUERIES_PER_TOPIC=3
DYNAMIC_TOPICS_TO_EXPAND=10
DYNAMIC_QUERY_MIN_SCORE=5.0
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=ClipRadar/0.4.1

# Whisper — modelo de transcrição local
# tiny | base | small | medium | large
# Sem GPU: use "base". Com GPU Nvidia: use "medium" ou "large"
WHISPER_MODEL_SIZE=base
WHISPER_LANGUAGE_MODE=auto
WHISPER_DEFAULT_LANGUAGE=
WHISPER_FORCE_PT_MARKET=true
WHISPER_FORCE_PT_CHANNELS=true

# Processamento
# Quantos vídeos processar por execução (cuidado com tempo)
MAX_VIDEOS_PER_RUN=5
MIN_CLIP_SECONDS=60
MAX_CLIP_SECONDS=150
CLIP_END_EXTENSION_SECONDS=15
TARGET_CLIP_SECONDS=90
SOFT_MAX_CLIP_SECONDS=120
HARD_MAX_CLIP_SECONDS=150
SHORT_CLIP_SECONDS_MIN=45
SHORT_CLIP_SECONDS_MAX=60
FULL_THOUGHT_SECONDS_MIN=75
FULL_THOUGHT_SECONDS_MAX=120
DIAGNOSTIC_CANDIDATES_TOP_N=8
PODCAST_DISCOVERY_ENABLED=true
PODCAST_DISCOVERY_MAX_RESULTS=30
PODCAST_DISCOVERY_DAYS_BACK=14
PODCAST_DISCOVERY_MIN_DURATION_SECONDS=480
PODCAST_DISCOVERY_MAX_PER_CHANNEL=3
PODCAST_DISCOVERY_MARKETS=BR,GLOBAL

# OpenAI — apenas para geração de títulos e hashtags
# Deixe vazio para usar placeholders sem custo
OPENAI_API_KEY=
